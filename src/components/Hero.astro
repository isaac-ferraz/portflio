---
import { Picture } from 'astro:assets';
import isaac from '~/assets/hero/isaac.png';
import Icon from './Icon.astro';
import { rich } from '~/i18n/rich';
import { useTranslations, type Lang } from '~/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const first = t('hero.first');
const last = t('hero.last');
const letters = (word: string, offset: number) =>
  [...word].map((ch, i) => ({ ch, i: i + offset }));
---

<section class="hero" id="inicio" aria-labelledby="hero-name" data-section="inicio">
  <div class="hero-dots halftone" data-speed="0.25" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy" data-speed="-0.12">
      <p class="eyebrow mono">{t('hero.eyebrow')}</p>
      <h1 class="hero-name" id="hero-name">
        <span class="sr-only">{first} {last}</span>
        <span class="line" aria-hidden="true">
          {letters(first, 0).map((l) => <span class="ch" style={`--i:${l.i}`}>{l.ch}</span>)}
        </span>
        <span class="line line-2" aria-hidden="true">
          {letters(last, first.length).map((l) => <span class="ch" style={`--i:${l.i}`}>{l.ch}</span>)}
        </span>
      </h1>
      <p class="lead" set:html={rich(t('hero.lead'))} />
      <div class="ctas">
        <a class="btn btn-primary" href="#projects">{t('hero.cta.projects')}<Icon name="arrowRight" /></a>
        <a class="btn" href="#contact">{t('hero.cta.contact')}</a>
      </div>
      <p class="status-pill"><span class="pulse" aria-hidden="true"></span>{t('hero.status')}</p>
    </div>

    <div class="hero-art" data-hero-art>
      <div class="art-burst" aria-hidden="true"></div>
      <Picture
        src={isaac}
        alt={t('hero.alt')}
        formats={['avif', 'webp']}
        widths={[320, 480, 640, 860, 1100]}
        sizes="(min-width: 64rem) 40vw, (min-width: 40rem) 60vw, 86vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        fallbackFormat="webp"
        class="art-img"
      />
      <span class="bubble b1" data-bubble aria-hidden="true">{t('hero.bubble1')}</span>
      <span class="bubble b2 is-accent" data-bubble data-tail="right" aria-hidden="true">{t('hero.bubble2')}</span>
      <span class="bubble b3" data-bubble aria-hidden="true">{t('hero.bubble3')}</span>
    </div>
  </div>
  <a class="scroll-cue" href="#about"><span>{t('hero.scroll')}</span><span class="cue-line" aria-hidden="true"></span></a>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; display: grid; align-items: center;
    padding-block: calc(var(--header-h) + 2rem) 5rem; overflow: clip;
  }
  .hero-dots {
    position: absolute; inset: -10% -5% 0; pointer-events: none;
    -webkit-mask-image: radial-gradient(60% 55% at var(--mx, 70%) var(--my, 45%), #000 10%, transparent 75%);
    mask-image: radial-gradient(60% 55% at var(--mx, 70%) var(--my, 45%), #000 10%, transparent 75%);
  }
  .hero-grid {
    position: relative; display: grid; gap: 2rem 3rem; align-items: center;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  }
  .eyebrow { font-size: var(--step--1); color: var(--ink-soft); margin-bottom: 1.2rem; }
  .hero-name {
    font-size: var(--step-5); line-height: 0.86; letter-spacing: -0.045em; font-weight: 800;
    text-transform: uppercase; margin-bottom: 1.6rem;
  }
  .line { display: block; overflow: clip; padding-bottom: 0.06em; }
  .line-2 { color: transparent; -webkit-text-stroke: 2px var(--ink); padding-left: 0.5em; }
  .ch { display: inline-block; }
  .lead { font-size: var(--step-2); line-height: 1.25; max-width: 32rem; font-weight: 500; }
  .lead :global(em) { color: var(--accent-ink); }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-block: 2rem 1.6rem; }
  .status-pill {
    display: inline-flex; align-items: center; gap: 0.6rem; font-size: var(--step--1);
    color: var(--ink-soft); font-weight: 600;
  }
  .pulse {
    position: relative; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: light-dark(#0f7a43, #4ade80);
  }
  .pulse::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; background: inherit; opacity: 0;
  }

  .hero-art { position: relative; justify-self: center; width: min(100%, 34rem); }
  .art-burst {
    position: absolute; inset: 8% 4% 10%; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 55%, transparent), transparent 72%);
    filter: blur(8px);
  }
  .hero-art :global(.art-img) {
    position: relative; width: 100%; height: auto;
    -webkit-mask-image: linear-gradient(#000 78%, transparent 99%);
    mask-image: linear-gradient(#000 78%, transparent 99%);
  }
  .bubble { position: absolute; font-size: clamp(0.85rem, 0.7rem + 0.6vw, 1.25rem); white-space: nowrap; z-index: 2; }
  .b1 { top: 6%; left: -6%; rotate: -8deg; }
  .b2 { top: 34%; right: -8%; rotate: 6deg; }
  .b3 { bottom: 20%; left: -10%; rotate: -4deg; }

  .scroll-cue {
    position: absolute; left: 50%; bottom: 1.4rem; translate: -50% 0;
    display: grid; justify-items: center; gap: 0.5rem; text-decoration: none;
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-soft); letter-spacing: 0.06em;
  }
  .cue-line { width: 2px; height: 2.6rem; background: linear-gradient(var(--ink-soft), transparent); transform-origin: top; }

  /* Entrada: só transform (o texto é pintado já na 1ª pintura → não atrasa o LCP). */
  @media (prefers-reduced-motion: no-preference) {
    .ch { animation: rise 0.9s var(--ease-out) both; animation-delay: calc(0.15s + var(--i) * 0.045s); }
    .bubble { animation: pop 0.6s cubic-bezier(0.34, 1.7, 0.5, 1) both; }
    .b1 { animation-delay: 0.85s; } .b2 { animation-delay: 1.05s; } .b3 { animation-delay: 1.25s; }
    .pulse::after { animation: pulse 2s var(--ease-out) infinite; }
    .cue-line { animation: cue 2.2s var(--ease-out) infinite; }
  }
  @keyframes rise { from { transform: translateY(105%) rotate(6deg); } }
  @keyframes pop { from { transform: scale(0); } }
  @keyframes pulse { from { opacity: 0.5; transform: scale(1); } to { opacity: 0; transform: scale(3); } }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

  @media (max-width: 63.99rem) {
    .hero { min-height: auto; padding-bottom: 6rem; }
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { order: -1; width: min(78%, 24rem); }
    .b1 { left: -14%; } .b2 { right: -14%; } .b3 { left: -16%; bottom: 14%; }
  }
  @media (max-width: 30rem) {
    .bubble { font-size: 0.75rem; }
    .b3 { display: none; }
  }
</style>
