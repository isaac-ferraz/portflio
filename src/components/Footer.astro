---
import Icon from './Icon.astro';
import { profile } from '~/data/profile';
import { useTranslations, type Lang } from '~/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p class="made">{t('footer.made')}</p>
    <ul class="social" role="list">
      <li><a href={profile.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a href={profile.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      <li><a href={`mailto:${profile.email}`}>E-mail</a></li>
    </ul>
    <p class="fine">© {year} {profile.name}</p>
    <a class="to-top" href="#conteudo" data-to-top><Icon name="arrowUp" />{t('footer.top')}</a>
  </div>
</footer>

<style>
  .site-footer { border-top: var(--border); padding-block: 2.5rem 3rem; background: var(--bg-2); }
  .wrap { display: grid; gap: 1rem 2rem; grid-template-columns: 1fr auto; align-items: center; }
  .made { font-weight: 650; }
  .social { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .social a { font-weight: 600; }
  .fine { color: var(--ink-soft); font-size: var(--step--1); }
  .to-top { display: inline-flex; gap: 0.4rem; align-items: center; justify-self: end; font-weight: 650; font-size: var(--step--1); }
  .to-top :global(svg) { width: 1rem; height: 1rem; }
  @media (max-width: 40rem) {
    .wrap { grid-template-columns: 1fr; }
    .to-top { justify-self: start; }
  }
</style>
