---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { journey } from '~/data/profile';
import { pick, pickText, useTranslations, type Lang } from '~/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Onda que desce pelo meio, cruzando de um lado ao outro a cada quadrinho.
const n = journey.length;
const seg = 100 / n;
let d = 'M50 0';
for (let i = 0; i < n; i++) {
  const y0 = i * seg;
  const x = i % 2 === 0 ? 18 : 82;
  d += ` C ${x} ${y0 + seg * 0.25}, ${x} ${y0 + seg * 0.75}, 50 ${y0 + seg}`;
}
---

<section class="section journey" id="journey" aria-labelledby="journey-title" data-section="journey">
  <div class="wrap">
    <SectionHeading num="02" id="journey-title" title={t('journey.title')} accent={t('journey.accent')} intro={t('journey.intro')} />
    <div class="track" data-journey>
      <svg class="path" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path class="path-bg" d={d} vector-effect="non-scaling-stroke" />
      </svg>
      <!-- A linha "se desenha" revelando o SVG de cima para baixo (clip-path), o que
           independe da escala do traço. -->
      <svg class="path path-fg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" data-journey-path>
        <path d={d} vector-effect="non-scaling-stroke" />
      </svg>
      <span class="rail" aria-hidden="true"><span class="rail-fill" data-journey-rail></span></span>
      <ol class="panels" role="list">
        {journey.map((s, i) => (
          <li class="panel" data-side={i % 2 === 0 ? 'left' : 'right'} data-variant={s.variant} data-reveal>
            <span class="panel-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p class="when mono">{pick(s.when, lang)}</p>
            <h3>{s.link ? <a class="stretched" href={s.link.href}>{pickText(s.title, lang)}</a> : pickText(s.title, lang)}</h3>
            <span class="chip">{pick(s.tag, lang)}</span>
            <p class="text">{pick(s.text, lang)}</p>
            {s.link && <span class="go" aria-hidden="true">{pick(s.link.label, lang)}<Icon name="arrowRight" /></span>}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .track { position: relative; }
  .path { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .path path { fill: none; stroke-linecap: round; }
  .path-bg { stroke: var(--line); stroke-width: 2; stroke-dasharray: 2 8; }
  .path-fg { clip-path: inset(0 0 calc(100% - var(--draw, 100%)) 0); }
  .path-fg path { stroke: var(--accent); stroke-width: 5; }
  .rail { display: none; }

  .panels { position: relative; display: grid; gap: clamp(2rem, 1rem + 4vw, 4.5rem); }
  .panel {
    position: relative; width: min(100%, 27rem);
    background: var(--surface); border: var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow-comic); padding: 1.4rem 1.4rem 1.5rem;
  }
  .panel[data-side='left'] { justify-self: start; rotate: -1deg; }
  .panel[data-side='right'] { justify-self: end; rotate: 1deg; }
  .panel-num {
    position: absolute; top: -0.9rem; right: 1rem; padding: 0.1rem 0.55rem;
    background: var(--accent); color: var(--on-accent); border: var(--border); border-radius: 8px;
    font-weight: 700; font-size: 0.85rem;
  }
  .when { font-size: 0.8rem; color: var(--accent-ink); margin-bottom: 0.4rem; letter-spacing: 0.04em; }
  h3 { font-size: var(--step-2); margin-bottom: 0.6rem; }
  .text { color: var(--ink-soft); margin-top: 0.8rem; }

  /* Painéis com link: o quadrinho inteiro é clicável. */
  .panel:has(.stretched) { transition: translate 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out); }
  .panel:has(.stretched):hover { translate: -3px -3px; box-shadow: 9px 9px 0 var(--accent); }
  .stretched { color: inherit; text-decoration: none; }
  .stretched::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .stretched:focus-visible { outline: none; }
  .panel:has(.stretched:focus-visible) { outline: 3px solid var(--accent-ink); outline-offset: 4px; }
  .go { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1rem; font-weight: 700; }
  .go :global(svg) { width: 1.1rem; height: 1.1rem; transition: translate 0.2s; }
  .panel:hover .go :global(svg) { translate: 4px 0; }

  /* O convite final ganha a cor de destaque. */
  .panel[data-variant='offer'] { background: var(--accent); color: var(--on-accent); }
  .panel[data-variant='offer'] .when,
  .panel[data-variant='offer'] .text { color: inherit; }
  .panel[data-variant='offer'] .panel-num { background: var(--surface); color: var(--ink); }
  .panel[data-variant='offer'] .chip { background: var(--surface); color: var(--ink); border-color: var(--ink); }
  .panel[data-variant='offer']:hover { box-shadow: 9px 9px 0 var(--ink); }

  @media (max-width: 47.99rem) {
    .path { display: none; }
    .rail {
      display: block; position: absolute; left: 0.6rem; top: 0; bottom: 0; width: 3px;
      background: var(--line); border-radius: 3px;
    }
    .rail-fill {
      display: block; height: 100%; background: var(--accent); border-radius: 3px;
      transform-origin: top; transform: scaleY(var(--fill, 1));
    }
    .panels { padding-left: 2.2rem; }
    .panel, .panel[data-side] { justify-self: stretch; width: auto; rotate: 0deg; }
    .panel::before {
      content: ''; position: absolute; left: -2.15rem; top: 1.6rem; width: 1rem; height: 1rem;
      border-radius: 50%; background: var(--accent); border: var(--border);
    }
  }
</style>
