---
import { alternatePath, homePath, otherLang, useTranslations, type Lang } from '~/i18n/utils';
import { sections } from '~/data/sections';

interface Props { lang: Lang; home: boolean }
const { lang, home } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const base = home ? '' : homePath(lang);
const links = sections.filter((s) => s.nav).map((s) => ({ href: `${base}#${s.id}`, label: t(s.nav!) }));
---

<header class="site-header" data-header>
  <div class="wrap">
    <a class="brand" href={homePath(lang)}>
      <span class="brand-mark" aria-hidden="true">IF</span>
      <span>Isaac Ferraz</span>
    </a>
    <nav aria-label={t('nav.label')}>
      <ul class="nav-links" role="list">
        {links.map((l) => <li><a href={l.href} data-nav-link>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="icon-btn" href={alternatePath(Astro.url, other)} hreflang={other} lang={other} aria-label={`${t('lang.short')} · ${t('lang.switch')}`}>
        {t('lang.short')}
      </a>
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle
        data-label-light={t('theme.toLight')} data-label-dark={t('theme.toDark')} aria-label={t('theme.toLight')}>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/></svg>
      </button>
      <button class="icon-btn menu-btn" type="button" popovertarget="mobile-menu" aria-label={t('nav.menu')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" popover>
    <nav aria-label={t('nav.menu')}>
      <ul role="list">
        {links.map((l) => <li><a href={l.href} data-close-menu>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
