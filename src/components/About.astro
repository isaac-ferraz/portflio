---
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Lang } from '~/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

/** Quebra o manifesto em palavras; trechos entre `*` viram destaque. */
const words: { w: string; em: boolean }[] = [];
let em = false;
for (const raw of t('about.manifesto').split(/\s+/)) {
  let w = raw;
  const opens = w.startsWith('*');
  if (opens) { em = true; w = w.slice(1); }
  const closes = /\*[.,;:!?—]*$/.test(w);
  w = w.replace('*', '');
  words.push({ w, em });
  if (closes) em = false;
}
const facts = (['1', '2', '3', '4'] as const).map((n) => ({
  k: t(`about.fact${n}.k`),
  v: t(`about.fact${n}.v`),
}));
---

<section class="section about" id="about" aria-labelledby="about-title" data-section="about">
  <div class="wrap">
    <SectionHeading num="01" id="about-title" title={t('about.title')} accent={t('about.accent')} />
    <div class="about-pin" data-manifesto>
      <p class="manifesto">
        {words.map((x) => (x.em ? <em class="w">{x.w}</em> : <span class="w">{x.w}</span>)).flatMap((n) => [n, ' '])}
      </p>
    </div>
    <dl class="facts">
      {facts.map((f) => (
        <div class="fact" data-reveal>
          <dt class="mono">{f.k}</dt>
          <dd>{f.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .manifesto {
    font-size: var(--step-3); line-height: 1.22; font-weight: 600; letter-spacing: -0.02em;
    max-width: 58rem;
  }
  .manifesto em { color: var(--accent-ink); font-size: 1.08em; position: relative; }
  /* Com JS de movimento, as palavras acendem com o scroll (ver motion). "Apagada"
     é a tinta misturada com o fundo, sem descer de 4.5:1 de contraste; os
     destaques em itálico mantêm a cor e ganham o marca-texto. */
  :global(.motion-on) span.w { color: color-mix(in oklab, var(--ink) calc(var(--o, 0.62) * 100%), var(--bg)); }
  :global(.motion-on) em.w {
    background: linear-gradient(transparent 62%, color-mix(in oklab, var(--accent) 45%, transparent) 62%) no-repeat 0 0 / var(--hl, 0%) 100%;
  }
  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem;
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }
  .fact {
    border: var(--border); border-radius: var(--radius); padding: 1.1rem 1.2rem;
    background: var(--surface); box-shadow: var(--shadow-comic);
  }
  .fact dt { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 0.35rem; }
  .fact dd { font-weight: 650; margin: 0; }
</style>
